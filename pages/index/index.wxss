/* pages/index/index.wxss */
.page-header {
  margin-bottom: 20rpx;
}

.header-logo {
  display: block;
  height: 100rpx;
}

.century-progress {
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.century-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.century-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.century-percent {
  font-size: 32rpx;
  font-weight: bold;
  color: #1665ad;
}

.progress-track {
  height: 20rpx;
  background-color: #eaf2fa;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(to right, #1665ad, #4a90d9);
  border-radius: 10rpx;
  transition: width 0.5s ease;
}

.century-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.countdown-section {
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}

.countdown-display {
  margin-bottom: 28rpx;
}

.days-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  color: #1665ad;
  margin-bottom: 24rpx;
}

.days-number {
  font-size: 112rpx;
  font-weight: bold;
  line-height: 1.2;
}

.days-label {
  font-size: 30rpx;
  font-weight: bold;
}

.clock-row {
  display: flex;
  gap: 16rpx;
}

.time-block {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.time-number {
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  font-size: 42rpx;
  font-weight: bold;
  color: #1665ad;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  text-align: center;
  overflow: hidden;
}

.time-reel {
  height: 200%;
  display: flex;
  flex-direction: column;
  transform: translateY(-50%);
}

.time-reel.is-rolling {
  animation: roll-down 480ms ease-in-out both;
}

.time-reel-face {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

@keyframes roll-down {
  from { transform: translateY(-50%); }
  to { transform: translateY(0); }
}

.time-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.target-date {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.welcome-info {
  padding: 30rpx;
  text-align: center;
  font-size: 28rpx;
}

.official-link {
  margin-top: 30rpx;
  padding: 30rpx;
  text-align: center;
}

.official-label {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.official-url {
  font-size: 26rpx;
  color: #1665ad;
  display: block;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.official-hint {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}
