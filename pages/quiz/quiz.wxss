/* pages/quiz/quiz.wxss */
.quiz-section {
  padding: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 40rpx;
}

.quiz-identity {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
  background-color: #eaf2fa;
  border-radius: 12rpx;
}

.quiz-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #fff;
  flex-shrink: 0;
}

.quiz-user {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.quiz-progress {
  margin-bottom: 40rpx;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 16rpx;
  background-color: #eaf2fa;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(to right, #1665ad, #4a90d9);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.question-text {
  font-size: 32rpx;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.options {
  margin-bottom: 40rpx;
}

.option {
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  background-color: #f0f0f0;
  border: 2rpx solid transparent;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.option.selected {
  background-color: #1665ad;
  color: white;
}

.option.is-correct {
  background-color: #e8f5e9;
  color: #2e7d32;
  border-color: #4CAF50;
}

.option.is-wrong {
  background-color: #ffebee;
  color: #c62828;
  border-color: #f44336;
}

.button-disabled {
  background-color: #ccc !important;
}

.result {
  margin-top: 40rpx;
  padding: 40rpx;
  border-radius: 20rpx;
  text-align: center;
  background-color: #f8f8f8;
}

.result-text {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.correct {
  color: #4CAF50;
}

.incorrect {
  color: #f44336;
}

.explanation {
  font-size: 28rpx;
  display: block;
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.result-summary {
  margin-top: 20rpx;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  text-align: center;
  background: linear-gradient(145deg, #eaf2fa, #ffffff);
}

.summary-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 30rpx;
  color: #333;
}

.summary-score {
  font-size: 96rpx;
  font-weight: bold;
  display: block;
  color: #1665ad;
  line-height: 1.2;
}

.summary-rate {
  font-size: 28rpx;
  display: block;
  color: #666;
  margin: 16rpx 0 30rpx;
}

.summary-grade {
  font-size: 30rpx;
  display: block;
  color: #e48f40;
  margin-bottom: 20rpx;
}

.summary-user {
  font-size: 26rpx;
  display: block;
  color: #999;
  margin-bottom: 40rpx;
}
