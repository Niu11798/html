/* pages/data/data.wxss */
.data-section {
  padding: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 40rpx;
}

.stats-container {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
  text-align: center;
}

.stat-title {
  font-size: 24rpx;
  color: #1665ad;
  display: block;
  min-height: 36rpx;
}

.stat-value {
  font-size: 38rpx;
  font-weight: bold;
  color: #1665ad;
  display: block;
  margin: 12rpx 0;
}

.stat-desc {
  color: #666;
  font-size: 21rpx;
  display: block;
}

.stats-note {
  display: block;
  margin-bottom: 40rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #777;
}

.map-title {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 30rpx;
}

.campus-map {
  position: relative;
  width: 100%;
  height: 640rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #eaf4ee, #f4f7eb);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.map-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0.55;
  background-image: linear-gradient(90deg, transparent 96%, #d1e0d7 96%),
    linear-gradient(transparent 96%, #d1e0d7 96%);
  background-size: 70rpx 70rpx;
}

.map-road {
  position: absolute;
  background-color: #fff;
  box-shadow: 0 0 0 3rpx #dfe9de;
}

.map-road-vertical {
  width: 22rpx;
  height: 130%;
  left: 49%;
  top: -15%;
  transform: rotate(16deg);
}

.map-road-horizontal {
  width: 130%;
  height: 20rpx;
  left: -15%;
  top: 54%;
  transform: rotate(-15deg);
}

.map-city-label,
.map-north {
  position: absolute;
  font-size: 22rpx;
  color: #668276;
}

.map-city-label {
  left: 30rpx;
  bottom: 24rpx;
}

.map-north {
  right: 28rpx;
  top: 22rpx;
  font-weight: bold;
}

.campus-pin {
  position: absolute;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 148rpx;
  min-height: 56rpx;
  padding: 8rpx;
  margin: 0;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
  border-radius: 30rpx;
  background-color: #fff;
  color: #1665ad;
  font-size: 23rpx;
  line-height: 1.2;
  box-shadow: 0 4rpx 12rpx rgba(19, 77, 125, 0.18);
}

.campus-pin::after {
  border: none;
}

.campus-pin.is-selected {
  background-color: #1665ad;
  color: #fff;
}

.campus-pin-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: #e48f40;
}

.campus-detail {
  margin-top: 30rpx;
  padding: 24rpx;
  background-color: #f8f8f8;
  border-radius: 16rpx;
  text-align: center;
}

.campus-detail-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1665ad;
  margin-bottom: 10rpx;
}

.campus-detail-address {
  display: block;
  font-size: 26rpx;
  color: #666;
}

.campus-detail-tip {
  font-size: 26rpx;
  color: #999;
}
