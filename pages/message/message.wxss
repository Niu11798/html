/* pages/message/message.wxss */
.message-board {
  padding: 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 40rpx;
}

.identity-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  background-color: #eaf2fa;
  border-radius: 16rpx;
}

.avatar-btn {
  flex-shrink: 0;
  width: 120rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  line-height: 1.2;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 2rpx solid #1665ad;
}

.avatar-tip {
  font-size: 20rpx;
  color: #1665ad;
}

.identity-right {
  flex: 1;
  min-width: 0;
}

.identity-label {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.nickname-input {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 12rpx 16rpx;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.message-form {
  margin-bottom: 40rpx;
}

.message-form textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  height: 200rpx;
  font-size: 28rpx;
}

.messages-list {
  max-height: 900rpx;
  overflow-y: auto;
}

.message-item {
  background-color: #f8f8f8;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.message-user-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.message-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #fff;
}

.message-user {
  font-weight: bold;
  font-size: 28rpx;
  color: #333;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.6;
}

.message-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 40rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ececec;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.like-icon {
  color: #c0c4cc;
}

.like-btn.active .like-icon {
  color: #e64340;
}

.like-btn.active .like-count {
  color: #1665ad;
  font-weight: bold;
}

.delete-btn {
  font-size: 26rpx;
  color: #e64340;
}
